# --- Backend ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=osspulse
POSTGRES_PASSWORD=osspulse_dev_password
POSTGRES_DB=osspulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://osspulse:osspulse_dev_password@postgres:5432/osspulse

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- GitHub OAuth ---
# Créer une OAuth App sur https://github.com/settings/developers
# Callback URL: http://localhost:4000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
# Token GitHub personnel (optionnel, pour développement sans OAuth)
GITHUB_PERSONAL_TOKEN=

# --- JWT ---
# Générer une clé : openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# --- AES Encryption (tokens GitHub en DB) ---
# Générer : openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- AI Service ---
AI_SERVICE_URL=http://ai-service:8000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
